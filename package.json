{
  "name": "heuristrans",
  "private": true,
  "version": "0.2.0",
  "description": "Software educativo para aprender las heurísticas del Problema de Transporte",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "formato": "prettier --write .",
    "formato:verificar": "prettier --check .",
    "verificar": "npm run lint && npm run formato:verificar && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.10.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
